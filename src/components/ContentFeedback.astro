---
import { getTranslations } from "@/lib/translations";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<div class="content-feedback rounded-xl border-2 border-(--color-accent-2) bg-(--color-surface) p-6 text-center md:p-8">
  <p class="text-display-4 text-(--color-ink)">
    {t.feedback.question}
  </p>

  <div class="mt-4 flex items-center justify-center gap-1.5" role="radiogroup" aria-label={t.feedback.rating_label}>
    {[1, 2, 3, 4, 5].map((n) => (
      <button type="button" class="cf-star p-0.5" data-value={n} role="radio" aria-checked="false" aria-label={`${n} star${n > 1 ? "s" : ""}`}>
        <span class="cf-star-glyph inline-block h-7 w-7 md:h-8 md:w-8" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <p class="cf-thanks mt-3 hidden text-sm font-semibold text-(--color-deep)">
    {t.feedback.thanks}
  </p>

  <div class="mt-6 border-t border-(--color-line) pt-5 text-left text-xs text-(--color-ink-soft)">
    <p>
      <strong class="text-(--color-ink)">{t.feedback.caution_label}</strong> {t.feedback.caution}
    </p>
  </div>
</div>

<style>
  /*
    Two icon files, one per state, swapped by mask. A single mask cannot draw
    an outline for "empty" and a solid for "rated", which is what the stars
    need to read as a control rather than a row of filled shapes.

    A new visitor sees five outlines in a soft grey; hovering previews the
    rating in gold; clicking keeps it.
  */
  .cf-star-glyph {
    background-color: var(--color-ink-soft);
    -webkit-mask: url("/images/icons/star.svg") center / contain no-repeat;
    mask: url("/images/icons/star.svg") center / contain no-repeat;
    transition: background-color 0.1s;
  }
  .cf-star.is-filled .cf-star-glyph {
    background-color: var(--color-accent-2);
    -webkit-mask-image: url("/images/icons/star-filled.svg");
    mask-image: url("/images/icons/star-filled.svg");
  }
</style>

<script>
  function initContentFeedback(root: ParentNode) {
    const stars = Array.from(root.querySelectorAll<HTMLButtonElement>(".cf-star"));
    const thanks = root.querySelector<HTMLElement>(".cf-thanks");
    if (stars.length === 0) return;

    const key = `bkpa-rating:${location.pathname}`;
    let rating = 0;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    try {
      rating = Number(localStorage.getItem(key)) || 0;
    } catch {}

    function paint(upTo: number) {
      stars.forEach((btn, i) => {
        btn.classList.toggle("is-filled", i < upTo);
        btn.setAttribute("aria-checked", String(i < upTo));
      });
    }

    function showThanks() {
      thanks?.classList.remove("hidden");
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => thanks?.classList.add("hidden"), 3000);
    }

    function setRating(n: number) {
      rating = n;
      paint(n);
      showThanks();
      try {
        localStorage.setItem(key, String(n));
      } catch {}
    }

    if (rating > 0) {
      paint(rating);
      showThanks();
    }

    stars.forEach((btn, i) => {
      btn.addEventListener("mouseenter", () => paint(i + 1));
      btn.addEventListener("mouseleave", () => paint(rating));
      btn.addEventListener("click", () => setRating(i + 1));
    });
  }

  function initAll() {
    document.querySelectorAll(".content-feedback").forEach((el) => initContentFeedback(el));
  }

  initAll();
  // This component is page content, so it is replaced on every client-side
  // navigation and has to be wired up again each time.
  document.addEventListener("astro:page-load", initAll);
</script>
