---
import Icon from "@/components/Icon.astro";
import { getTranslations } from "@/lib/translations";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 backdrop-blur-sm sm:px-4 sm:pt-[10vh] [&.open]:flex"
  role="dialog"
  aria-modal="true"
  aria-label={t.search.dialog_label}
>
  <div class="flex h-dvh w-full flex-col overflow-hidden border-(--color-line) bg-(--color-surface) shadow-2xl sm:h-auto sm:max-h-[75vh] sm:max-w-xl sm:rounded-lg sm:border">
    {/*
      The bar is the focus indicator, not the input. The site's global
      :focus-visible outline is right for links and buttons, but on a text
      field the caret already says "you are here", and a 2px box hugging a
      small input reads as a cramped border rather than a focus cue. So the
      input suppresses its own outline and the bar's bottom edge turns green
      via focus-within instead — a wide, calm signal rather than a tight one.
    */}
    <div class="flex items-center gap-3 border-b-2 border-(--color-line) px-5 py-2 transition-colors focus-within:border-(--color-deep) sm:px-6">
      <Icon name="search" class="h-6 w-6 flex-none text-(--color-ink-soft)" />
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        class="min-w-0 flex-1 bg-transparent py-4 text-lg text-(--color-ink) placeholder:text-(--color-ink-soft) focus:outline-none focus-visible:outline-none sm:py-3.5 sm:text-xl"
        placeholder={t.search.placeholder}
      />
      <button id="search-close" type="button" class="flex-none rounded-md p-3 text-(--color-ink-soft) hover:bg-(--color-surface-2) hover:text-(--color-ink) sm:p-2" aria-label={t.search.close}>
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>
    <div id="search-results" class="flex-1 overflow-y-auto p-2 [&_mark]:rounded-sm [&_mark]:bg-(--color-accent-2)/25 [&_mark]:px-0.5 [&_mark]:text-(--color-ink)">
      <p id="search-empty" class="px-3 py-8 text-center text-[1.0625rem] text-(--color-ink-soft) sm:text-sm">
        {t.search.start_typing}
      </p>
    </div>
  </div>
</div>

<script define:vars={{ base, t: { startTyping: t.search.start_typing, noResults: t.search.no_results, unavailable: t.search.unavailable } }}>
  let modal, input, resultsEl, closeBtn;

  function grabElements() {
    modal = document.getElementById("search-modal");
    input = document.getElementById("search-input");
    resultsEl = document.getElementById("search-results");
    closeBtn = document.getElementById("search-close");
    return Boolean(modal && input && resultsEl && closeBtn);
  }
  grabElements();

  let pagefind = null;
  let pagefindLoading = null;

  function loadPagefind() {
    if (!pagefindLoading) {
      pagefindLoading = import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`)
        .then((mod) => {
          pagefind = mod;
          return mod.init();
        })
        .catch(() => {
          resultsEl.innerHTML = `<p class="px-3 py-8 text-center text-[1.0625rem] text-(--color-ink-soft) sm:text-sm">${t.unavailable}</p>`;
        });
    }
    return pagefindLoading;
  }

  function openModal() {
    modal.classList.add("open");
    document.body.style.overflow = "hidden";
    loadPagefind();
    setTimeout(() => input.focus(), 30);
  }

  function closeModal() {
    modal.classList.remove("open");
    document.body.style.overflow = "";
  }

  // Bound once: document outlives every navigation.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.classList.contains("open")) closeModal();
  });

  let debounceTimer;

  function onSearchInput() {
    clearTimeout(debounceTimer);
    const query = input.value.trim();
    if (!query) {
      resultsEl.innerHTML =
        `<p class="px-3 py-8 text-center text-[1.0625rem] text-(--color-ink-soft) sm:text-sm">${t.startTyping}</p>`;
      return;
    }
    resultsEl.innerHTML = '<p class="px-3 py-8 text-center text-[1.0625rem] text-(--color-ink-soft) sm:text-sm">…</p>';
    debounceTimer = setTimeout(async () => {
      await loadPagefind();
      if (!pagefind) return;
      const search = await pagefind.search(query);
      if (search.results.length === 0) {
        resultsEl.innerHTML =
          `<p class="px-3 py-8 text-center text-[1.0625rem] text-(--color-ink-soft) sm:text-sm">${t.noResults}</p>`;
        return;
      }
      const dataItems = await Promise.all(search.results.slice(0, 12).map((r) => r.data()));
      resultsEl.innerHTML = "";
      for (const item of dataItems) {
        const a = document.createElement("a");
        a.href = item.url;
        a.className = "block rounded-md px-3 py-3.5 hover:bg-(--color-surface-2) sm:py-2.5";
        a.innerHTML = `
          <span class="block text-[1.125rem] leading-snug font-semibold text-(--color-ink) sm:text-base">${item.meta?.title ?? item.url}</span>
          <span class="mt-1.5 block text-body-sm text-(--color-ink-soft)">${item.excerpt}</span>
        `;
        resultsEl.appendChild(a);
      }
    }, 200);
  }

  /**
   * Astro swaps the body on navigation, so the modal and the header's search
   * button are new elements each time and their handlers have to be attached
   * again. Guarded per element, so a repeated pass cannot double-bind and make
   * one click toggle the modal twice.
   *
   * Pagefind's loaded index deliberately stays at module scope above: it is
   * fetched once and reused, not re-downloaded on every page.
   */
  function bindSearch() {
    if (!grabElements()) return;

    document.querySelectorAll("[data-search-open]").forEach((btn) => {
      if (btn.dataset.searchBound) return;
      btn.dataset.searchBound = "1";
      btn.addEventListener("click", openModal);
    });

    if (!closeBtn.dataset.searchBound) {
      closeBtn.dataset.searchBound = "1";
      closeBtn.addEventListener("click", closeModal);
    }
    if (!modal.dataset.searchBound) {
      modal.dataset.searchBound = "1";
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }
    if (!input.dataset.searchBound) {
      input.dataset.searchBound = "1";
      input.addEventListener("input", onSearchInput);
    }
  }

  bindSearch();
  document.addEventListener("astro:page-load", bindSearch);
</script>
