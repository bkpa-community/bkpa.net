---
import { CATEGORIES, EMERGENCY_CATEGORIES } from "@/lib/categories";

interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = "h-5 w-5" } = Astro.props;

const category =
  [...CATEGORIES, ...EMERGENCY_CATEGORIES].find((c) => c.slug === slug);
const icon = category?.icon ?? "/images/icons/others.svg";
---

{/*
  The icon is a standalone file under public/images/icons/, referenced by path,
  so it can be swapped through the CMS without touching code.

  Drawn with mask-image rather than <img> deliberately. Inside an <img> the
  SVG is its own document, so its stroke="currentColor" resolves to black
  instead of inheriting the surrounding text colour — these icons sit on green
  cards and in coloured nav, and would all turn black. A mask keeps the file
  external while letting background-color carry the inherited colour through.
*/}
<span
  class={`inline-block flex-none bg-current ${className}`}
  style={`-webkit-mask: url('${icon}') center / contain no-repeat; mask: url('${icon}') center / contain no-repeat;`}
  role="img"
  aria-hidden="true"
></span>
