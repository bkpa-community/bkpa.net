import { getArticles } from "@/lib/content";
import { defaultLanguage } from "@/lib/languageParser";

const lang = defaultLanguage.languageCode;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function excerpt(markdown: string, maxLength = 140) {
  const plain = markdown
    .replace(/^#+\s*/gm, "")
    .replace(/\*\*(.*?)\*\*/g, "$1")
    .replace(/\*(.*?)\*/g, "$1")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_>`~#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return plain.length > maxLength ? `${plain.slice(0, maxLength).trim()}...` : plain;
}

const allArticles = (await getArticles(lang)).filter((a) => !a.data.draft);
const articleByHref = new Map(
