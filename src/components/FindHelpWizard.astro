const DATA = { STEPS, TOPICS, PERSONA_INTRO };
---

<div class="fh-wizard">
  <p id="fh-progress" class="font-mono text-xs tracking-wider text-(--color-ink-soft) uppercase"></p>

  <div id="fh-question" class="mt-4">
    <h2 id="fh-question-title" class="text-display-4"></h2>
    <div id="fh-options" class="mt-5 grid gap-3.5 sm:grid-cols-2"></div>
    <button type="button" id="fh-multi-next" class="mt-5 hidden rounded-md bg-(--color-deep) px-5 py-2.5 text-sm font-semibold text-(--color-deep-ink) hover:brightness-110">
      <span class="i18n-bn bn">পরবর্তী</span><span class="i18n-en">Next</span> →
    </button>
    <button type="button" id="fh-back" class="mt-5 hidden font-mono text-xs tracking-wider text-(--color-ink-soft) uppercase hover:text-(--color-deep)">
      ← <span class="i18n-bn bn">পেছনে</span><span class="i18n-en">Back</span>
    </button>
  </div>

  <!-- Results -->
  <div id="fh-results" class="mt-4 hidden">
    <p id="fh-results-intro" class="text-(--color-ink-soft)"></p>
    <div id="fh-results-list" class="mt-5 grid gap-6 sm:grid-cols-2"></div>
    <button type="button" id="fh-restart" class="mt-6 font-mono text-xs tracking-wider text-(--color-ink-soft) uppercase hover:text-(--color-deep)">
      ↻ <span class="i18n-bn bn">আবার শুরু করুন</span><span class="i18n-en">Start over</span>
    </button>
  </div>
</div>

<script define:vars={{ DATA }}>
  const { STEPS, TOPICS, PERSONA_INTRO } = DATA;
  const lang = () => document.getElementById("page")?.getAttribute("data-lang") || "bn";
  const t = (obj) => (lang() === "en" ? obj.en : obj.bn);

  const profile = { role: null, condition: null, stage: null, comorbidities: [] };
  let stepIndex = 0; // index into visible STEPS, or -1 for topic-picker, or -2 for results
  let multiSelected = [];

  // Re-queried on each navigation rather than captured once: with client-side
  // routing these elements are replaced every time the body is swapped, and
  // refs held from the first page would point at detached nodes.
  let questionEl, titleEl, optionsEl, multiNextBtn, backBtn, resultsEl, progressEl;

  function grabWizard() {
    questionEl = document.getElementById("fh-question");
    titleEl = document.getElementById("fh-question-title");
    optionsEl = document.getElementById("fh-options");
    multiNextBtn = document.getElementById("fh-multi-next");
    backBtn = document.getElementById("fh-back");
    resultsEl = document.getElementById("fh-results");
    progressEl = document.getElementById("fh-progress");
    // The wizard appears on the homepage and /find-help only.
    return Boolean(questionEl && optionsEl && resultsEl);
  }

  // Step visibility rules (kept in JS, not on the STEPS data, since Astro's
  // define:vars JSON-serializes DATA and functions don't survive that trip).
  function isStepVisible(step) {
    if (step.key === "condition") return !!profile.role && profile.role !== "general";
    if (step.key === "stage") return profile.condition === "ckd";
    return true;
  }

  function visibleSteps() {
    return STEPS.filter(isStepVisible);
  }

  function getRecommendedTopics() {
    const { role, condition, stage, comorbidities } = profile;
    const hasDiabetes = comorbidities.includes("diabetes");
    const hasBP = comorbidities.includes("hypertension");
    const stageNum = parseInt(stage) || 0;
    let ids = [];

    if (role === "general") {
      ids = ["symptoms", "prevention", "tests", "stages"];
      if (hasDiabetes) ids.push("sugar");
      if (hasBP) ids.push("bp");
      return ids;
    }
    if (role === "at_risk") {
      ids = ["symptoms", "prevention", "tests"];
      if (hasDiabetes) ids.push("sugar");
      if (hasBP) ids.push("bp", "salt");
      ids.push("stages");
      return ids;
    }
    if (condition === "dialysis") {
      ids = ["dialysis_process", "fistula", "dry_weight", "diet", "potassium", "water", "salt", "anemia", "infection", "transplant", "vaccine", "fasting"];
      if (hasDiabetes) ids.splice(6, 0, "sugar");
      if (hasBP) ids.splice(6, 0, "bp");
      return ids;
    }
    if (condition === "transplant") {
      ids = ["infection", "vaccine", "diet", "medicine", "tests", "prevention"];
      if (hasDiabetes) ids.splice(3, 0, "sugar");
      if (hasBP) ids.splice(3, 0, "bp");
      ids.push("fasting", "pregnancy");
      return ids;
    }
    if (condition === "aki") {
      ids = ["tests", "water", "diet", "medicine", "symptoms"];
      if (hasDiabetes) ids.push("sugar");
      if (hasBP) ids.push("bp");
      ids.push("prevention");
      return ids;
    }
    if (condition === "ckd") {
      if (stageNum <= 2) {
        ids = ["prevention", "diet", "salt", "tests", "stages", "medicine"];
        if (hasDiabetes) ids.splice(2, 0, "sugar");
        if (hasBP) ids.splice(2, 0, "bp");
        ids.push("fasting");
      } else if (stageNum === 3) {
        ids = ["diet", "potassium", "phosphorus", "salt", "water", "anemia", "bone", "tests", "medicine"];
        if (hasDiabetes) ids.splice(5, 0, "sugar");
        if (hasBP) ids.splice(5, 0, "bp");
        ids.push("dialysis_prep", "fasting");
      } else if (stageNum === 4) {
        ids = ["dialysis_prep", "fistula", "diet", "potassium", "phosphorus", "water", "salt", "anemia", "bone"];
        if (hasDiabetes) ids.splice(7, 0, "sugar");
        if (hasBP) ids.splice(7, 0, "bp");
        ids.push("transplant", "infection", "vaccine", "fasting");
      } else if (stageNum >= 5) {
        ids = ["dialysis_process", "dialysis_prep", "fistula", "diet", "potassium", "water", "salt", "anemia", "bone", "transplant", "infection", "vaccine"];
        if (hasDiabetes) ids.splice(7, 0, "sugar");
        if (hasBP) ids.splice(7, 0, "bp");
        ids.push("dry_weight", "fasting");
      } else {
        ids = ["stages", "tests", "diet", "salt", "water", "prevention", "medicine"];
        if (hasDiabetes) ids.push("sugar");
        if (hasBP) ids.push("bp");
        ids.push("anemia", "fasting");
      }
      return ids;
    }
    ids = ["symptoms", "tests", "stages", "prevention"];
    if (hasDiabetes) ids.push("sugar");
    if (hasBP) ids.push("bp");
    ids.push("diet", "medicine");
    return ids;
  }

  function render() {
    resultsEl.classList.add("hidden");
    questionEl.classList.remove("hidden");

    if (stepIndex === -1) {
      renderTopicPicker();
      return;
    }

    const steps = visibleSteps();
    const step = steps[stepIndex];
    progressEl.textContent = `${lang() === "en" ? "Step" : "ধাপ"} ${stepIndex + 1} / ${steps.length + 1}`;
    titleEl.textContent = t(step.q);
    optionsEl.innerHTML = "";
    multiNextBtn.classList.toggle("hidden", !step.multi);
    backBtn.classList.toggle("hidden", stepIndex === 0);

    if (step.multi) {
      multiSelected = [];
      step.options.forEach((opt) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "fh-option rounded-lg border border-(--color-line) bg-(--color-surface) p-4 text-left text-sm font-semibold hover:border-(--color-deep)";
        btn.textContent = t(opt);
        btn.addEventListener("click", () => {
          if (opt.value === "none") {
            multiSelected = ["none"];
          } else {
            multiSelected = multiSelected.filter((v) => v !== "none");
            multiSelected = multiSelected.includes(opt.value) ? multiSelected.filter((v) => v !== opt.value) : [...multiSelected, opt.value];
          }
          syncMultiHighlight();
        });
        btn.dataset.value = opt.value;
        optionsEl.appendChild(btn);
      });
      syncMultiHighlight();
    } else {
      step.options.forEach((opt) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "fh-option flex items-center gap-3 rounded-lg border border-(--color-line) bg-(--color-surface) p-4 text-left text-sm font-semibold hover:border-(--color-deep)";
        if (opt.icon) {
          btn.innerHTML = `
            <svg class="h-6 w-6 flex-none text-(--color-deep)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${opt.icon}</svg>
            <span>${t(opt)}</span>
          `;
        } else {
          btn.textContent = t(opt);
        }
        btn.addEventListener("click", () => {
          profile[step.key] = opt.value;
          advance();
        });
        optionsEl.appendChild(btn);
      });
    }
  }

  function syncMultiHighlight() {
    optionsEl.querySelectorAll("[data-value]").forEach((btn) => {
      btn.classList.toggle("border-(--color-deep)", multiSelected.includes(btn.dataset.value));
      btn.classList.toggle("bg-(--color-surface-2)", multiSelected.includes(btn.dataset.value));
    });
  }

  function renderTopicPicker() {
    const steps = visibleSteps();
    progressEl.textContent = `${lang() === "en" ? "Step" : "ধাপ"} ${steps.length + 1} / ${steps.length + 1}`;
    titleEl.textContent = lang() === "en" ? "What would you like to know about?" : "আপনি কী সম্পর্কে জানতে চান?";
    backBtn.classList.remove("hidden");
    multiNextBtn.classList.add("hidden");
    optionsEl.innerHTML = "";
    getRecommendedTopics().forEach((id) => {
      const topic = TOPICS[id];
      if (!topic) return;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "fh-option flex flex-col rounded-lg border border-(--color-line) bg-(--color-surface) p-4 text-left hover:border-(--color-deep)";
      btn.innerHTML = `<span class="text-sm font-semibold">${t(topic)}</span><span class="mt-1 text-xs text-(--color-ink-soft)">${t(topic.desc)}</span>`;
      btn.addEventListener("click", () => showResults(id));
      optionsEl.appendChild(btn);
    });
  }

  function advance() {
    const steps = visibleSteps();
    if (stepIndex < steps.length - 1) {
      stepIndex++;
    } else {
      stepIndex = -1;
    }
    render();
  }



  function showResults(topicId) {
    questionEl.classList.add("hidden");
    resultsEl.classList.remove("hidden");
    progressEl.textContent = lang() === "en" ? "Result" : "ফলাফল";

    const intro = PERSONA_INTRO[profile.role] || PERSONA_INTRO.general;
    document.getElementById("fh-results-intro").textContent = t(intro);

    const topic = TOPICS[topicId];
    const listEl = document.getElementById("fh-results-list");
    listEl.innerHTML = "";
    (topic?.links || []).forEach((link) => {
      const cardTitle = link.title || t(link);
      const cardExcerpt = lang() === "en" ? link.excerptEn : link.excerptBn;
      const a = document.createElement("a");
      a.href = link.href;
      a.className = "group flex flex-col overflow-hidden rounded-lg border border-(--color-line) bg-(--color-surface) hover:border-(--color-deep)";
      a.innerHTML = `
        ${link.image ? `
          <div class="aspect-video overflow-hidden bg-(--color-surface-2)">
            <img class="h-full w-full object-cover transition group-hover:scale-105" src="${link.image}" alt="" loading="lazy" width="640" height="360" />
          </div>
        ` : ""}
        <div class="flex flex-1 flex-col p-5">
          <h3 class="text-display-4 leading-snug">${cardTitle}</h3>
          ${cardExcerpt ? `<p class="mt-2 line-clamp-3 flex-1 text-sm text-(--color-ink-soft)">${cardExcerpt}</p>` : ""}
        </div>
      `;
      listEl.appendChild(a);
    });
    resultsEl.dataset.topic = topicId;
  }

  let langObserver = null;

  function bindOnce(el, handler) {
    if (!el || el.dataset.fhBound) return;
    el.dataset.fhBound = "1";
    el.addEventListener("click", handler);
  }

  /**
   * Runs on first load and after every client-side navigation.
   *
   * Without this the wizard rendered blank whenever the reader came back to a
   * page carrying it: its markup is server-rendered empty and filled in by
   * render(), which previously ran only once, on the very first page load.
   *
   * State is reset each time so returning to the homepage starts a fresh
   * questionnaire rather than resuming a half-finished one from earlier.
   */
  function initWizard() {
    if (!grabWizard()) return;

    profile.role = profile.condition = profile.stage = null;
    profile.comorbidities = [];
    stepIndex = 0;
    multiSelected = [];

    bindOnce(multiNextBtn, () => {
      profile.comorbidities = multiSelected.length ? multiSelected : ["none"];
      advance();
    });

    bindOnce(backBtn, () => {
      if (stepIndex === -1) {
        stepIndex = visibleSteps().length - 1;
      } else if (stepIndex > 0) {
        stepIndex--;
      }
      render();
    });

    bindOnce(document.getElementById("fh-restart"), () => {
      profile.role = profile.condition = profile.stage = null;
      profile.comorbidities = [];
      stepIndex = 0;
      render();
    });

    const presetRole = new URLSearchParams(window.location.search).get("role");
    if (presetRole && STEPS[0].options.some((o) => o.value === presetRole)) {
      profile.role = presetRole;
      advance();
    } else {
      render();
    }

    // Re-render on a language change. Disconnected first, so navigating
    // repeatedly does not stack observers all firing on one attribute change.
    langObserver?.disconnect();
    const pageEl = document.getElementById("page");
    if (pageEl) {
      langObserver = new MutationObserver(() => {
        if (!resultsEl.classList.contains("hidden") && resultsEl.dataset.topic) {
          showResults(resultsEl.dataset.topic);
        } else {
          render();
        }
      });
      langObserver.observe(pageEl, { attributes: true, attributeFilter: ["data-lang"] });
    }
  }

  initWizard();
  document.addEventListener("astro:page-load", initWizard);
</script>
