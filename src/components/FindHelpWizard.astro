for (const topic of Object.values(TOPICS)) {
  for (const link of topic.links as any[]) {
    const article = articleByHref.get(link.href);
    if (article) {
      const ex = excerpt(article.body ?? "");
      link.title = article.data.title;
      link.excerptBn = ex;
      link.excerptEn = ex;
      link.image = article.data.image ? encodeURI(`${base}${article.data.image}`) : null;
    } else {
      link.title = null;
      link.excerptBn = topic.desc.bn;
      link.excerptEn = topic.desc.en;
      link.image = null;
    }
  }
}

