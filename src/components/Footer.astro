---
import { CATEGORIES, EMERGENCY_CATEGORIES } from "@/lib/categories";
import { slugSelector } from "@/lib/languageParser";
import { getMenu, getTranslations } from "@/lib/translations";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const menu = getMenu(lang);
const label = (c: { labelEn: string; labelBn: string }) =>
  lang === "en" ? c.labelEn : c.labelBn;
---

<footer class="border-t border-(--color-line) bg-(--color-surface)">
  <div class="mx-auto grid max-w-6xl gap-9 px-6 py-12 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-10">
    <div>
      <a class="flex items-center no-underline" href={slugSelector("/", lang)}>
        <img class="h-9 w-auto" src="/images/logo.png" alt="BKPA Foundation" width="420" height="127" />
      </a>
      <p class="mt-3.5 max-w-sm text-[0.88rem] text-(--color-ink-soft)">{t.footer.blurb}</p>
    </div>

    <div>
      <h4 class="mb-3.5 text-eyebrow text-(--color-ink-soft)">{t.nav.know_your_kidney}</h4>
      <ul class="flex flex-col gap-2.5">
        {CATEGORIES.slice(0, 4).map((c) => (
          <li><a class="text-sm hover:text-(--color-deep)" href={slugSelector(`/${c.slug}`, lang)}>{label(c)}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="mb-3.5 text-eyebrow text-(--color-ink-soft)">{t.nav.emergency_contacts}</h4>
      <ul class="flex flex-col gap-2.5">
        {EMERGENCY_CATEGORIES.slice(0, 4).map((c) => (
          <li><a class="text-sm hover:text-(--color-deep)" href={slugSelector(`/emergency-contacts/${c.slug}`, lang)}>{label(c)}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="mb-3.5 text-eyebrow text-(--color-ink-soft)">{t.nav.organization}</h4>
      <ul class="flex flex-col gap-2.5">
        {menu.footer.map((item) => (
          <li>
            <a
              class="text-sm hover:text-(--color-deep)"
              href={item.external ? item.url : slugSelector(item.url, lang)}
              {...(item.external ? { target: "_blank", rel: "noopener" } : {})}
            >{item.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-(--color-line)">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-4 text-[0.8rem] text-(--color-ink-soft) md:px-10">
      <span>© {new Date().getFullYear()} BKPA Foundation. {t.common.all_rights}</span>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {menu.footer_bottom.map((item) => (
          <a class="hover:text-(--color-deep) hover:underline" href={slugSelector(item.url, lang)}>{item.name}</a>
        ))}
        <a class="underline" href="https://mehedisharif.com" target="_blank" rel="noopener">Developed by Mehedi</a>
      </div>
    </div>
  </div>
</footer>
