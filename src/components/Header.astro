---
import Icon from "@/components/Icon.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import { CATEGORIES, EMERGENCY_CATEGORIES } from "@/lib/categories";
import {
  isMultilingual,
  slugSelector,
  stripLanguage,
  supportedLanguages,
} from "@/lib/languageParser";
import { getMenu, getTranslations } from "@/lib/translations";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const menu = getMenu(lang);

// Dropdown children are resolved from data, so a new category appears in the
// nav by being added to categories.ts — not by editing markup here.
const CHILDREN = {
  categories: CATEGORIES.map((c) => ({
    name: lang === "en" ? c.labelEn : c.labelBn,
    url: `/${c.slug}`,
    slug: c.slug,
  })),
  emergencyCategories: EMERGENCY_CATEGORIES.map((c) => ({
    name: lang === "en" ? c.labelEn : c.labelBn,
    url: `/emergency-contacts/${c.slug}`,
    slug: c.slug,
  })),
};

function childrenFor(key: string | undefined) {
  return key ? (CHILDREN[key as keyof typeof CHILDREN] ?? []) : [];
}

// The switcher points at the same page in the other language rather than the
// homepage, so changing language never costs the reader their place.
const currentPath = stripLanguage(Astro.url.pathname);
---

<header class="sticky top-0 z-40 border-b border-(--color-line) bg-(--color-paper)/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3 md:px-10">
    <a class="flex items-center" href={slugSelector("/", lang)}>
      <img class="h-9 w-auto" src="/images/logo.png" alt="BKPA Foundation" width="420" height="127" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {menu.main.map((item) => (
        item.hasChildren ? (
          <div class="group relative flex">
            <span class="flex cursor-default items-center gap-1 text-sm font-semibold" tabindex="0">
              {item.name}
              <Icon name="chevron-down" class="h-2.5 w-2.5 opacity-60" />
            </span>
            <div class="invisible absolute top-full left-1/2 -translate-x-1/2 pt-3.5 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="grid w-72 grid-cols-1 gap-0.5 rounded-lg border border-(--color-line) bg-(--color-surface) p-2 shadow-xl">
                {childrenFor(item.children).map((child) => (
                  <a class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-(--color-ink-soft) hover:bg-(--color-surface-2) hover:text-(--color-ink)" href={slugSelector(child.url, lang)}>
                    <CategoryIcon slug={child.slug} class="h-4 w-4 flex-none" />
                    {child.name}
                  </a>
                ))}
                {item.children === "categories" && (
                  <a class="rounded-md px-3 py-2 text-sm text-(--color-ink-soft) hover:bg-(--color-surface-2) hover:text-(--color-ink)" href={slugSelector("/faq", lang)}>
                    {t.nav.faq}
                  </a>
                )}
              </div>
            </div>
          </div>
        ) : (
          <a class="text-sm font-semibold hover:text-(--color-deep)" href={slugSelector(item.url, lang)}>{item.name}</a>
        )
      ))}

      <a class="rounded-md bg-(--color-deep) px-3.5 py-2 text-sm font-semibold text-(--color-deep-ink) hover:brightness-110" href={slugSelector(menu.cta.url, lang)}>
        {menu.cta.name}
      </a>
    </nav>

    <div class="flex items-center gap-2.5">
      <button type="button" data-search-open class="inline-flex items-center gap-2 rounded-md border border-(--color-line) px-3 py-2.5 hover:bg-(--color-surface-2) lg:px-2 lg:py-2" aria-label={t.search.label}>
        <Icon name="search" class="h-5 w-5 lg:h-4.5 lg:w-4.5" />
        <span class="text-sm font-semibold lg:hidden">{t.search.label}</span>
      </button>

      {/*
        Real links, not a client-side toggle. Each language is a distinct URL
        that can be linked to, shared and indexed — a DOM toggle rendered both
        languages into every page and let neither be addressed.
      */}
      {isMultilingual && (
      <div class="hidden overflow-hidden rounded-full border border-(--color-line) font-mono text-xs font-semibold lg:flex" role="group" aria-label={t.common.language}>
        {supportedLanguages.map((language) => (
          <a
            href={slugSelector(currentPath, language.languageCode)}
            hreflang={language.languageCode}
            aria-current={language.languageCode === lang ? "true" : undefined}
            class:list={[
              "px-3 py-1.5",
              language.languageCode === lang
                ? "bg-(--color-deep) text-(--color-deep-ink)"
                : "text-(--color-ink-soft) hover:text-(--color-ink)",
            ]}
          >{language.languageName}</a>
        ))}
      </div>
      )}

      <button
        id="mobile-toggle"
        class="inline-flex rounded-md border border-(--color-line) p-2 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.toggle_menu}
      >
        <Icon name="menu" class="h-4.5 w-4.5" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden max-h-[calc(100dvh-var(--header-h,4rem))] overflow-y-auto overscroll-contain border-t border-(--color-line) px-6 pb-4 [&.open]:block lg:!hidden">
    {isMultilingual && (
    <div class="flex justify-center py-3">
      <div class="flex overflow-hidden rounded-full border border-(--color-line) font-mono text-xs font-semibold" role="group" aria-label={t.common.language}>
        {supportedLanguages.map((language) => (
          <a
            href={slugSelector(currentPath, language.languageCode)}
            hreflang={language.languageCode}
            aria-current={language.languageCode === lang ? "true" : undefined}
            class:list={[
              "px-5 py-2",
              language.languageCode === lang
                ? "bg-(--color-deep) text-(--color-deep-ink)"
                : "text-(--color-ink-soft)",
            ]}
          >{language.languageName}</a>
        ))}
      </div>
    </div>
    )}

    {menu.main.map((item) => (
      item.hasChildren ? (
        <>
          <p class="pt-3 text-eyebrow text-(--color-ink-soft)">{item.name}</p>
          {childrenFor(item.children).map((child) => (
            <a class="flex items-center gap-2.5 border-b border-(--color-line) py-2.5 text-sm font-semibold" href={slugSelector(child.url, lang)}>
              <CategoryIcon slug={child.slug} class="h-4 w-4 flex-none" />
              {child.name}
            </a>
          ))}
        </>
      ) : (
        <a class="block border-b border-(--color-line) py-2.5 text-sm font-semibold" href={slugSelector(item.url, lang)}>{item.name}</a>
      )
    ))}

    <a class="mt-3 block rounded-md bg-(--color-deep) px-3.5 py-2.5 text-center text-sm font-semibold text-(--color-deep-ink)" href={slugSelector(menu.cta.url, lang)}>
      {menu.cta.name}
    </a>
  </div>
</header>
