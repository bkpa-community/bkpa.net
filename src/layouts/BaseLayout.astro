---
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SearchModal from "@/components/SearchModal.astro";
import "@/styles/global.css";
import config from "@/config/config.json";
import { organizationSchema } from "@/lib/schema";
import { publicImageMeta } from "@/lib/images";
import {
  defaultLanguage,
  isMultilingual,
  slugSelector,
  stripLanguage,
  supportedLanguages,
} from "@/lib/languageParser";

interface Props {
  title: string;
  description?: string;
  schema?: object | object[];
  lang?: string;
  /**
   * Page-specific share image. Falls back to the logo. Given as a site-root
   * path (e.g. /images/foo.jpg); it is resolved to an absolute URL below
   * because Facebook, X and LinkedIn all reject a relative og:image.
   */
  image?: string;
  /** "article" for posts, so shares render with the article treatment. */
  ogType?: "website" | "article";
}
const {
  title,
  description = "Bangladesh Kidney Patient Association (BKPA) Foundation",
  schema,
  lang = defaultLanguage.languageCode,
  image,
  ogType = "website",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageTitle = `${title} · BKPA Foundation`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// encodeURI because filenames here contain spaces and other characters that
// are legal on disk but break an unescaped URL in a scraper.
const shareImage = image ?? config.metadata.meta_image;
const shareImagePath = `${base}${shareImage}`;
const ogImageURL = new URL(encodeURI(shareImagePath), Astro.site);
const ogImageMeta = await publicImageMeta(shareImage);
// The large card wants a wide image; anything narrower than Facebook's own
// 600px minimum for it is better as the small square.
const twitterCard = ogImageMeta && ogImageMeta.width >= 600 ? "summary_large_image" : "summary";
const schemaBlocks = [organizationSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
const gaId = config.params.google_analytics_id;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={slugSelector(`/images/favicon.png`, lang)} />
    <link rel="canonical" href={canonicalURL} />
    {isMultilingual && supportedLanguages.map((language) => (
      <link
        rel="alternate"
        hreflang={language.languageCode}
        href={new URL(slugSelector(stripLanguage(Astro.url.pathname), language.languageCode), Astro.site)}
      />
    ))}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="BKPA Foundation" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {
      ogImageMeta && (
        <>
          <meta property="og:image:type" content={ogImageMeta.type} />
          <meta property="og:image:width" content={String(ogImageMeta.width)} />
          <meta property="og:image:height" content={String(ogImageMeta.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {schemaBlocks.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block).replace(/</g, "\\u003c")} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter />
    {
      gaId && (
        <>
          <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          {/*
            is:inline so the tag survives view transitions: ClientRouter keeps
            head scripts whose markup is unchanged, so this runs exactly once
            per real page load and the astro:page-load listener below then
            reports every client-side navigation. send_page_view is off
            because astro:page-load also fires on the initial load — letting
            config() send its own page_view as well would count it twice.
          */}
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId, { send_page_view: false });
            document.addEventListener("astro:page-load", () => {
              gtag("event", "page_view", {
                page_title: document.title,
                page_location: location.href,
              });
            });
          </script>
        </>
      )
    }
  </head>
  <body id="page" data-lang={lang} class="overflow-x-hidden">
    <Header lang={lang} />
    <main data-pagefind-body>
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchModal lang={lang} />
    <script>
      /**
       * Only the mobile menu needs scripting now. Language used to be a
       * client-side toggle over two copies of every string; it is a URL, so
       * the page arrives in one language already rendered.
       *
       * Astro replaces the body on navigation, so this rebinds on
       * astro:page-load and guards each element against double-binding.
       */
      function syncMenuHeight() {
        const headerBar = document.querySelector("header > div");
        const mobNav = document.getElementById("mobile-nav");
        if (!headerBar || !mobNav) return;
        mobNav.style.setProperty("--header-h", `${headerBar.getBoundingClientRect().height}px`);
      }

      function bind() {
        const mobBtn = document.getElementById("mobile-toggle");
        const mobNav = document.getElementById("mobile-nav");

        mobNav?.classList.remove("open");
        mobBtn?.setAttribute("aria-expanded", "false");
        syncMenuHeight();

        if (mobBtn && !mobBtn.dataset.bound) {
          mobBtn.dataset.bound = "1";
          mobBtn.addEventListener("click", () => {
            syncMenuHeight();
            const open = document.getElementById("mobile-nav")?.classList.toggle("open");
            mobBtn.setAttribute("aria-expanded", String(!!open));
          });
        }
      }

      document.addEventListener("astro:page-load", bind);
      window.addEventListener("resize", syncMenuHeight);
    </script>
  </body>
</html>
