---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import "../styles/global.css";
import { organizationSchema } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  schema?: object | object[];
}
const { title, description = "Bangladesh Kidney Patient Association (BKPA) Foundation", schema } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageTitle = `${title} · BKPA Foundation`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}/images/logo.png`, Astro.site);
const schemaBlocks = [organizationSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/images/favicon.png`} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BKPA Foundation" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {schemaBlocks.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block).replace(/</g, "\\u003c")} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter />
  </head>
  <body id="page" data-lang="bn" class="overflow-x-hidden">
    <Header />
    <main data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <script>
      /**
       * Wiring for client-side routing.
       *
       * Astro replaces the whole body on navigation, so every element these
       * listeners are attached to is discarded and rebuilt. Binding once on
       * first load would therefore work exactly until the reader clicked
       * something. Everything element-bound is instead (re)bound on
       * astro:page-load, which fires on the initial load and after every
       * navigation.
       *
       * Each bind is guarded by a data flag, so if this script is ever
       * evaluated more than once no element ends up with duplicate handlers
       * firing a toggle twice and cancelling itself out.
       */
      type Lang = "bn" | "en";
      const LANG_KEY = "bkpa-lang";

      function savedLang(): Lang | null {
        try {
          const value = localStorage.getItem(LANG_KEY);
          return value === "en" || value === "bn" ? value : null;
        } catch {
          return null;
        }
      }

      function applyLang(lang: Lang) {
        document.body.setAttribute("data-lang", lang);
        document.documentElement.lang = lang;
        document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]").forEach((btn) => {
          btn.setAttribute("aria-pressed", String(btn.dataset.langBtn === lang));
        });
      }

      function setLang(lang: Lang) {
        applyLang(lang);
        try {
          localStorage.setItem(LANG_KEY, lang);
        } catch {}
      }

      /** The body's data-lang resets to the server default on every swap. */
      function restoreLang() {
        applyLang(savedLang() ?? ((document.body.getAttribute("data-lang") as Lang) || "bn"));
      }

      function syncMenuHeight() {
        const headerBar = document.querySelector("header > div");
        const mobNav = document.getElementById("mobile-nav");
        if (!headerBar || !mobNav) return;
        mobNav.style.setProperty("--header-h", `${headerBar.getBoundingClientRect().height}px`);
      }

      function bind() {
        restoreLang();

        document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]").forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = "1";
          btn.addEventListener("click", () => setLang(btn.dataset.langBtn as Lang));
        });

        const mobBtn = document.getElementById("mobile-toggle");
        const mobNav = document.getElementById("mobile-nav");

        // A fresh body means a freshly closed menu; make the button agree.
        mobNav?.classList.remove("open");
        mobBtn?.setAttribute("aria-expanded", "false");
        syncMenuHeight();

        if (mobBtn && !mobBtn.dataset.bound) {
          mobBtn.dataset.bound = "1";
          mobBtn.addEventListener("click", () => {
            syncMenuHeight();
            const open = document.getElementById("mobile-nav")?.classList.toggle("open");
            mobBtn.setAttribute("aria-expanded", String(!!open));
          });
        }
      }

      // Correct the language before paint so the server default never flashes.
      document.addEventListener("astro:after-swap", restoreLang);

      // Fires on first load and after every client-side navigation.
      document.addEventListener("astro:page-load", bind);

      // window survives navigation, so this binds once and stays valid.
      window.addEventListener("resize", syncMenuHeight);
    </script>
  </body>
</html>
