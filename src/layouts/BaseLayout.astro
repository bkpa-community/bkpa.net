---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import "../styles/global.css";
import { organizationSchema } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  schema?: object | object[];
}
const { title, description = "Bangladesh Kidney Patient Association (BKPA) Foundation", schema } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageTitle = `${title} · BKPA Foundation`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}/images/logo.png`, Astro.site);
const schemaBlocks = [organizationSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/images/favicon.png`} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BKPA Foundation" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {schemaBlocks.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block).replace(/</g, "\\u003c")} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&family=Tiro+Bangla&family=Hind+Siliguri:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body id="page" data-lang="bn" class="overflow-x-hidden">
    <Header />
    <main data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <script>
      const page = document.getElementById("page")!;
      const saved = (() => {
        try {
          return localStorage.getItem("bkpa-lang");
        } catch {
          return null;
        }
      })();
      if (saved === "en" || saved === "bn") {
        page.setAttribute("data-lang", saved);
        document.documentElement.lang = saved;
      }

      function setLang(lang: "bn" | "en") {
        page.setAttribute("data-lang", lang);
        document.documentElement.lang = lang;
        document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]").forEach((btn) => {
          btn.setAttribute("aria-pressed", String(btn.dataset.langBtn === lang));
        });
        try {
          localStorage.setItem("bkpa-lang", lang);
        } catch {}
      }
      document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]").forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.dataset.langBtn === page.getAttribute("data-lang")));
        btn.addEventListener("click", () => setLang(btn.dataset.langBtn as "bn" | "en"));
      });

      const mobBtn = document.getElementById("mobile-toggle");
      const mobNav = document.getElementById("mobile-nav");

      // The open menu is capped at the viewport minus the bar above it, so a
      // long menu scrolls instead of running off the bottom with no way back.
      // Measured rather than assumed: the bar's height changes with the
      // viewport, and a hardcoded guess either clips the last item or leaves
      // a dead gap under it.
      const headerBar = document.querySelector("header > div");
      function syncMenuHeight() {
        if (!headerBar || !mobNav) return;
        const barHeight = headerBar.getBoundingClientRect().height;
        mobNav.style.setProperty("--header-h", `${barHeight}px`);
      }
      syncMenuHeight();
      window.addEventListener("resize", syncMenuHeight);

      mobBtn?.addEventListener("click", () => {
        syncMenuHeight();
        const open = mobNav?.classList.toggle("open");
        mobBtn.setAttribute("aria-expanded", String(!!open));
      });
    </script>
  </body>
</html>
