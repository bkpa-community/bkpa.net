---
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import { getSiteContact } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { breadcrumbSchema } from "@/lib/schema";

const contact = (await getSiteContact(lang))!.data;
const pageSchema = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact" },
]);
---

<BaseLayout title="Contact" description={contact.title} schema={pageSchema}>
  <section class="py-12">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p class="text-eyebrow text-(--color-ink-soft)"><span class="i18n-bn bn">যোগাযোগ</span><span class="i18n-en">Contact Us</span></p>
      <h1 class="mt-1.5 text-display-2 text-(--color-ink)">{contact.title}</h1>

      <div class="mt-9 grid gap-4 sm:grid-cols-2">
        {contact.items.map((item) => (
          <div class="rounded-lg border border-(--color-line) bg-(--color-surface) p-5">
            <h2 class="text-eyebrow text-(--color-ink-soft)">{item.name}</h2>
            <p class="mt-2 whitespace-pre-line text-sm">{item.content}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
