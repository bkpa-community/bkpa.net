---
import { getArticles } from "@/lib/content";
import { langParam, supportedLanguages } from "@/lib/languageParser";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentFeedback from "@/components/ContentFeedback.astro";
import OpenRemark from "@/components/OpenRemark.astro";
import { render } from "astro:content";
import { categoryBySlug } from "@/lib/categories";
import { articleSchema, breadcrumbSchema } from "@/lib/schema";


export async function getStaticPaths() {
  const paths = [];
  for (const language of supportedLanguages) {
    const all = (await getArticles(language.languageCode)).filter((a) => !a.data.draft);
    for (const a of all) {
      const [category, ...rest] = a.id.split("/");
      paths.push({
        params: { lang: langParam(language.languageCode), category, slug: rest.join("/") },
        props: { entry: a, lang: language.languageCode },
      });
    }
  }
  return paths;
}

const { category } = Astro.params;
const cat = categoryBySlug(category)!;
const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const articlePath = `/know-your-kidney/${cat.slug}/${entry.id.split("/").slice(1).join("/")}`;

const pageSchema = [
  articleSchema({
    title: entry.data.title,
    description: entry.data.description || cat.labelEn,
    path: articlePath,
    image: entry.data.image,
    datePublished: entry.data.date,
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: cat.labelEn, path: `/know-your-kidney/${cat.slug}` },
    { name: entry.data.title, path: articlePath },
  ]),
];
---

<BaseLayout title={entry.data.title} description={entry.data.description || cat.labelEn} schema={pageSchema}>
  <article class="py-12">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <a class="text-eyebrow text-(--color-ink-soft) hover:text-(--color-deep)" href={`${base}/know-your-kidney/${cat.slug}`}>
        ← <span class="i18n-en">{cat.labelEn}</span><span class="i18n-bn bn">{cat.labelBn}</span>
      </a>
      <h1 class="mt-3 text-display-2 text-balance text-(--color-ink)">{entry.data.title}</h1>
      {entry.data.date && (
        <time class="mt-2 block font-mono text-xs text-(--color-ink-soft)" datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString("en-CA")}
        </time>
      )}
      {entry.data.image && <img class="mt-6 h-56 w-full rounded-lg border border-(--color-line) object-cover sm:h-72 md:h-96" src={encodeURI(`${base}${entry.data.image}`)} alt="" loading="eager" />}
      <div class="prose-bkpa mt-8">
        <Content />
      </div>
      <div class="mt-10">
        <ContentFeedback />
      </div>
      <div class="mt-10">
        <OpenRemark />
      </div>
    </div>
  </article>
</BaseLayout>
