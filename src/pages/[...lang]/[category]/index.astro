---
import { slugSelector } from "@/lib/languageParser";
import { getTranslations } from "@/lib/translations";
import { getArticles } from "@/lib/content";
import { defaultLanguage, langParam, supportedLanguages } from "@/lib/languageParser";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import Redirect from "@/components/Redirect.astro";
import { CATEGORIES, categoryBySlug } from "@/lib/categories";
import { collectionPageSchema, breadcrumbSchema } from "@/lib/schema";


const { lang, redirectTo } = Astro.props;
const t = getTranslations(lang);

export async function getStaticPaths() {
  const categoryPages = supportedLanguages.flatMap((language) =>
    CATEGORIES.map((c) => ({
      params: { lang: langParam(language.languageCode), category: c.slug },
      props: { lang: language.languageCode, redirectTo: null as string | null },
    })),
  );

  // Redirects from the old Hugo site, which served every article at the root
  // under its filename (permalink "/:filename/"). Those URLs were live for
  // years and are what is indexed and shared, so each one forwards to the
  // article's current home.
  //
  // This lives in the same route as the category listing because both occupy
  // the single root segment, and Astro will not accept two dynamic routes
  // there. The targets come from the built entry ids, not filenames — Astro
  // slugifies on the way in (lowercase, spaces to hyphens, trailing dots
  // dropped), and a redirect built from the raw filename missed 15 of them.
  //
  // Bengali only: the old site had no English tree.
  const bn = defaultLanguage.languageCode;
  const articles = (await getArticles(bn))
    .filter((a) => !a.data.draft)
    // "others" sorts last, so when a slug exists in two categories the
    // specific one claims the redirect.
    .sort((a, b) => Number(a.id.startsWith("others/")) - Number(b.id.startsWith("others/")));
  const claimed = new Set<string>();
  const legacy = articles.flatMap((a) => {
    const [category, ...rest] = a.id.split("/");
    const slug = rest.join("/");
    const rawName = a.filePath?.split("/").pop()?.replace(/\.md$/, "");
    // The slugified id is always a source; the raw filename too, when it
    // differs, since Hugo's own normalisation may have produced either.
    const sources = new Set([slug, rawName].filter(Boolean) as string[]);
    return [...sources]
      .filter((src) => !CATEGORIES.some((c) => c.slug === src))
      .filter((src) => !claimed.has(src) && claimed.add(src))
      .map((src) => ({
        params: { lang: undefined, category: src },
        props: { lang: bn, redirectTo: `/${category}/${slug}` },
      }));
  });

  return [...categoryPages, ...legacy];
}

function excerpt(markdown: string, maxLength = 160) {
  const plain = markdown
    .replace(/^#+\s*/gm, "")
    .replace(/\*\*(.*?)\*\*/g, "$1")
    .replace(/\*(.*?)\*/g, "$1")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_>`~#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return plain.length > maxLength ? `${plain.slice(0, maxLength).trim()}...` : plain;
}

const { category } = Astro.params;
const cat = redirectTo ? null : categoryBySlug(category)!;
const catSlug = cat?.slug ?? "";
const all = (await getArticles(lang)).filter((a) => !a.data.draft);
const items = all
  .filter((a) => a.id.startsWith(`${catSlug}/`))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pageSchema = cat
  ? [
      collectionPageSchema({
        name: cat.labelEn,
        description: `${cat.labelEn} — articles from BKPA Foundation`,
        path: `/${cat.slug}`,
        items: items.map((a) => ({ name: a.data.title, path: `/${cat.slug}/${a.id.split("/").slice(1).join("/")}` })),
      }),
      breadcrumbSchema([
        { name: "Home", path: "/" },
        { name: cat.labelEn, path: `/${cat.slug}` },
      ]),
    ]
  : [];
---

{cat === null ? (
  <Redirect to={redirectTo!} />
) : (
<BaseLayout lang={lang} title={cat.labelEn} description={`${cat.labelEn} — articles from BKPA Foundation`} schema={pageSchema}>
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="text-eyebrow text-(--color-ink-soft)">
        {t.kidney.know_your_kidney}
      </p>
      <h1 class="mt-1.5 flex items-center gap-3 text-display-2 text-(--color-ink)">
        <CategoryIcon slug={cat.slug} class="h-8 w-8 flex-none text-(--color-deep)" />
        <span>
          {lang === "en" ? cat.labelEn : cat.labelBn}
        </span>
      </h1>

      {items.length === 0 && (
        <p class="mt-8 text-(--color-ink-soft)">
          {t.kidney.no_articles_have_been_published_in_this_cate}
        </p>
      )}

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((a) => (
          <a
            class="group flex flex-col overflow-hidden rounded-lg border border-(--color-line) hover:border-(--color-deep)"
            href={slugSelector(`/${cat.slug}/${a.id.split("/").slice(1).join("/")}`, lang)}
          >
            {a.data.image && (
              <div class="aspect-video overflow-hidden bg-(--color-surface-2)">
                <img
                  class="h-full w-full object-cover transition group-hover:scale-105"
                  src={encodeURI(`${base}${a.data.image}`)}
                  alt=""
                  loading="lazy"
                  width="640"
                  height="360"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col gap-2 p-5">
              <h2 class="text-display-4 leading-snug text-(--color-ink) group-hover:text-(--color-deep)">{a.data.title}</h2>
              <p class="line-clamp-3 flex-1 text-body-sm text-(--color-ink-soft)">{excerpt(a.body ?? "")}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
)}
