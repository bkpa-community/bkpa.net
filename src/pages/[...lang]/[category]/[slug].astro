---
import { slugSelector } from "@/lib/languageParser";
import { getTranslations } from "@/lib/translations";
import { getArticles } from "@/lib/content";
import { langParam, supportedLanguages } from "@/lib/languageParser";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentFeedback from "@/components/ContentFeedback.astro";
import OpenRemark from "@/components/OpenRemark.astro";
import { render } from "astro:content";
import { categoryBySlug } from "@/lib/categories";
import { articleSchema, breadcrumbSchema } from "@/lib/schema";



export async function getStaticPaths() {
  const paths = [];
  for (const language of supportedLanguages) {
    const all = (await getArticles(language.languageCode)).filter((a) => !a.data.draft);
    for (const a of all) {
      const [category, ...rest] = a.id.split("/");
      paths.push({
        params: { lang: langParam(language.languageCode), category, slug: rest.join("/") },
        props: { entry: a, lang: language.languageCode },
      });
    }
  }
  return paths;
}

const { category } = Astro.params;
const cat = categoryBySlug(category)!;
const { entry, lang } = Astro.props;
const t = getTranslations(lang);
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const articlePath = `/${cat.slug}/${entry.id.split("/").slice(1).join("/")}`;

const pageSchema = [
  articleSchema({
    title: entry.data.title,
    description: entry.data.description || cat.labelEn,
    path: articlePath,
    image: entry.data.image,
    datePublished: entry.data.date,
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: cat.labelEn, path: `/${cat.slug}` },
    { name: entry.data.title, path: articlePath },
  ]),
];
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description || cat.labelEn} schema={pageSchema} image={entry.data.image} ogType="article">
  <article class="py-12">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <a class="text-eyebrow text-(--color-ink-soft) hover:text-(--color-deep)" href={slugSelector(`/${cat.slug}`, lang)}>
        ← {lang === "en" ? cat.labelEn : cat.labelBn}
      </a>
      <h1 class="mt-3 text-display-2 text-balance text-(--color-ink)">{entry.data.title}</h1>
      {entry.data.date && (
        <time class="mt-2 block font-mono text-xs text-(--color-ink-soft)" datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString("en-CA")}
        </time>
      )}
      {/*
        Shown whole, at the image's own proportions. The header used to be a
        fixed-height band with object-cover, which cut the top and bottom off
        anything that wasn't roughly 3:1 — on a site where the images are
        checklists and labelled diagrams, that removed the part people needed
        to read. A max-height keeps a portrait image from becoming a wall;
        past that cap it is letterboxed, never cropped.
      */}
      {entry.data.image && (
        <img
          class="mt-6 h-auto max-h-[40rem] w-full rounded-lg border border-(--color-line) bg-(--color-surface-2) object-contain"
          src={encodeURI(`${base}${entry.data.image}`)}
          alt=""
          loading="eager"
        />
      )}
      <div class="prose-bkpa mt-8">
        <Content />
      </div>
      <div class="mt-10">
        <ContentFeedback lang={lang} />
      </div>
      <div class="mt-10">
        <OpenRemark />
      </div>
    </div>
  </article>
</BaseLayout>
