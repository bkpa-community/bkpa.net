---
import { slugSelector } from "@/lib/languageParser";
import { getTranslations } from "@/lib/translations";
import { getArticles } from "@/lib/content";
import { langParam, supportedLanguages } from "@/lib/languageParser";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentFeedback from "@/components/ContentFeedback.astro";
import OpenRemark from "@/components/OpenRemark.astro";
import Redirect from "@/components/Redirect.astro";
import { render } from "astro:content";
import { categoryBySlug } from "@/lib/categories";
import { articleSchema, breadcrumbSchema } from "@/lib/schema";
import { excerpt } from "@/lib/excerpt";



export async function getStaticPaths() {
  const paths = [];
  for (const language of supportedLanguages) {
    const lang = language.languageCode;
    const all = (await getArticles(lang)).filter((a) => !a.data.draft);
    // Astro keeps the last of two paths with the same params, so an alias
    // that matched a live slug would quietly replace that article with a
    // redirect to itself. Refuse to build instead.
    const taken = new Map(all.map((a) => [a.id, a.filePath ?? a.id]));
    for (const a of all) {
      const [category, ...rest] = a.id.split("/");
      const slug = rest.join("/");
      paths.push({
        params: { lang: langParam(lang), category, slug },
        props: { entry: a, lang, redirectTo: null as string | null },
      });
      // A renamed article keeps answering at its old slugs, each a stub that
      // forwards to the current URL. Same category: an alias only records the
      // slug, since a category move would change the meaning of the article,
      // not just its address.
      for (const alias of a.data.aliases) {
        const id = `${category}/${alias}`;
        if (taken.has(id)) {
          throw new Error(
            `Alias "${alias}" in ${a.filePath ?? a.id} is already the URL of ${taken.get(id)}. An alias must be a slug no live article in the same category uses.`,
          );
        }
        taken.set(id, a.filePath ?? a.id);
        paths.push({
          params: { lang: langParam(lang), category, slug: alias },
          // Trailing slash, as the page's own canonical has: GitHub Pages
          // would otherwise add one with a second redirect. slugSelector
          // strips it, so it goes on after.
          props: { entry: a, lang, redirectTo: `${slugSelector(`/${category}/${slug}`, lang)}/` },
        });
      }
    }
  }
  return paths;
}

const { category } = Astro.params;
const cat = categoryBySlug(category)!;
const { entry, lang, redirectTo } = Astro.props;
const t = getTranslations(lang);
// A redirect stub has no body to render.
const { Content } = redirectTo ? { Content: null } : await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const articlePath = `/${cat.slug}/${entry.id.split("/").slice(1).join("/")}`;
// Most articles have no description, and a share card that reads only
// "Chronic Kidney Disease (CKD)" tells nobody why to click. The opening
// sentences do.
const description = entry.data.description || excerpt(entry.body ?? "") || cat.labelEn;

const pageSchema = [
  articleSchema({
    title: entry.data.title,
    description,
    path: articlePath,
    image: entry.data.image,
    datePublished: entry.data.date,
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: cat.labelEn, path: `/${cat.slug}` },
    { name: entry.data.title, path: articlePath },
  ]),
];
---

{redirectTo ? <Redirect to={redirectTo} /> : (
<BaseLayout lang={lang} title={entry.data.title} description={description} schema={pageSchema} image={entry.data.image} ogType="article" noindex={entry.data.unlisted}>
  <article class="py-12">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <a class="text-eyebrow text-(--color-ink-soft) hover:text-(--color-deep)" href={slugSelector(`/${cat.slug}`, lang)}>
        ← {lang === "en" ? cat.labelEn : cat.labelBn}
      </a>
      <h1 class="mt-3 text-display-2 text-balance text-(--color-ink)">{entry.data.title}</h1>
      {entry.data.date && (
        <time class="mt-2 block font-mono text-xs text-(--color-ink-soft)" datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString("en-CA")}
        </time>
      )}
      {/*
        Shown whole, at the image's own proportions. The header used to be a
        fixed-height band with object-cover, which cut the top and bottom off
        anything that wasn't roughly 3:1 — on a site where the images are
        checklists and labelled diagrams, that removed the part people needed
        to read. A max-height keeps a portrait image from becoming a wall;
        past that cap it is letterboxed, never cropped.
      */}
      {entry.data.image && (
        <img
          class="mt-6 h-auto max-h-[40rem] w-full rounded-lg border border-(--color-line) bg-(--color-surface-2) object-contain"
          src={encodeURI(`${base}${entry.data.image}`)}
          alt=""
          loading="eager"
        />
      )}
      <div class="prose-bkpa mt-8">
        {Content && <Content />}
      </div>
      <div class="mt-10">
        <ContentFeedback lang={lang} />
      </div>
      <div class="mt-10">
        <OpenRemark />
      </div>
    </div>
  </article>
</BaseLayout>
)}
