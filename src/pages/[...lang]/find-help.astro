---
import { getTranslations } from "@/lib/translations";
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import BaseLayout from "@/layouts/BaseLayout.astro";
import FindHelpWizard from "@/components/FindHelpWizard.astro";

const t = getTranslations(lang);
---

<BaseLayout lang={lang} title={t.nav.find_help} description="Answer a few quick questions and we'll point you to the right BKPA Foundation resources.">
  <section class="bg-(--color-deep) py-10 text-(--color-deep-ink)">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p class="text-eyebrow opacity-75">{t.find_help.find_help}</p>
      <h1 class="mt-1.5 text-display-2">
        {t.find_help.how_can_we_help}
      </h1>
      <p class="mt-2 max-w-xl opacity-90">
        {t.find_help.answer_a_few_quick_questions_and_we_ll_point}
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-4xl px-6 md:px-10">
      <FindHelpWizard lang={lang} />
    </div>
  </section>
</BaseLayout>
