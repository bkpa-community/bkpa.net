---
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import BaseLayout from "@/layouts/BaseLayout.astro";
import FindHelpWizard from "@/components/FindHelpWizard.astro";
---

<BaseLayout title="Find Help" description="Answer a few quick questions and we'll point you to the right BKPA Foundation resources.">
  <section class="bg-(--color-deep) py-10 text-(--color-deep-ink)">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p class="text-eyebrow opacity-75"><span class="i18n-bn bn">সহায়তা খুঁজুন</span><span class="i18n-en">Find Help</span></p>
      <h1 class="mt-1.5 text-display-2">
        <span class="i18n-bn bn">আমরা কীভাবে সাহায্য করতে পারি?</span><span class="i18n-en">How can we help?</span>
      </h1>
      <p class="mt-2 max-w-xl opacity-90">
        <span class="i18n-bn bn-body">কয়েকটি প্রশ্নের উত্তর দিন, আমরা আপনাকে সঠিক তথ্যের দিকে পথ দেখাবো।</span>
        <span class="i18n-en">Answer a few quick questions and we'll point you to the right resources.</span>
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-4xl px-6 md:px-10">
      <FindHelpWizard />
    </div>
  </section>
</BaseLayout>
