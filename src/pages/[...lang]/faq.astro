---
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import { getSiteFaq } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { faqPageSchema } from "@/lib/schema";

const faq = (await getSiteFaq(lang))!.data;
const pageSchema = faqPageSchema(faq.items);
---

<BaseLayout title="FAQ" description={faq.title} schema={pageSchema}>
  <section class="py-12">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p class="text-eyebrow text-(--color-ink-soft)"><span class="i18n-bn bn">প্রায় জিজ্ঞাসিত প্রশ্ন</span><span class="i18n-en">FAQ</span></p>
      <h1 class="mt-1.5 text-display-2 text-(--color-ink)">{faq.title}</h1>

      <div class="mt-9 flex flex-col divide-y divide-(--color-line) rounded-lg border border-(--color-line) bg-(--color-surface)">
        {faq.items.map((item) => (
          <details class="group p-5">
            <summary class="cursor-pointer list-none font-semibold marker:content-none">
              <span class="flex items-center justify-between gap-4">
                {item.question}
                <svg class="h-4 w-4 flex-none text-(--color-ink-soft) transition group-open:rotate-45" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M10 4v12M4 10h12"></path>
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-sm text-(--color-ink-soft)">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
