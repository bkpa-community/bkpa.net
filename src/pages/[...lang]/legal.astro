---
import { slugSelector } from "@/lib/languageParser";
import { getTranslations } from "@/lib/translations";
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import BaseLayout from "@/layouts/BaseLayout.astro";
import { breadcrumbSchema } from "@/lib/schema";

const t = getTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// TODO(BKPA): fill these in from the registration certificate, then this block
// renders automatically. Left empty deliberately — publishing a placeholder
// registration number would be worse than publishing none.
const REGISTRATION: { number: string; authority: string; date: string } = {
  number: "",
  authority: "",
  date: "",
};

// Update when the text below is materially revised, not on every deploy.
const LAST_UPDATED = "৪ সেপ্টেম্বর ২০২৬";
const LAST_UPDATED_EN = "4 September 2026";

const pageSchema = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Legal & Compliance", path: "/legal" },
]);
---

<BaseLayout lang={lang}
  title={t.nav.legal}
  description="Legal terms, medical disclaimer, directory listing policy and privacy information for the BKPA Foundation website."
  schema={pageSchema}
>
  <section class="bg-(--color-deep) py-10 text-(--color-deep-ink)">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p class="text-eyebrow opacity-75">
        {t.legal.legal_information}
      </p>
      <h1 class="mt-1.5 text-display-2">
        {t.legal.legal_compliance}
      </h1>
      <p class="mt-2 text-sm opacity-80">
        {t.legal.last_updated_last_updated_en}
      </p>
    </div>
  </section>

  <article class="py-12">
    <div class="mx-auto max-w-3xl space-y-10 px-6 md:px-10">

      <!-- The one that matters most on a site full of clinical information. -->
      <div class="rounded-lg border-2 border-(--color-accent-2) bg-(--color-surface) p-6">
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.this_is_not_medical_advice}
        </h2>
        <div class="mt-3 space-y-3 text-(--color-ink-soft)">
          <p>
            {t.legal.everything_on_this_website_is_published_for_}
          </p>
          <p>
            {t.legal.always_consult_a_qualified_physician_before_}
          </p>
          <p class="font-semibold text-(--color-ink)">
            {t.legal.in_an_emergency_contact_your_nearest_hospita}
          </p>
          <p>
            {t.legal.using_this_website_does_not_create_a_doctor_}
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.about_the_organisation}
        </h2>
        <div class="mt-3 space-y-3 text-(--color-ink-soft)">
          <p>
            {t.legal.bangladesh_kidney_patient_foundation_bkpa_fo}
          </p>
          {REGISTRATION.number && (
            <p>
              {t.legal.registration_number_registration_number_regi}
            </p>
          )}
        </div>
      </div>

      <!-- Directory listings are the site's largest legal exposure: real named
           people, their photographs and their phone numbers. -->
      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.directory_listings_and_endorsement}
        </h2>
        <div class="mt-3 space-y-3 text-(--color-ink-soft)">
          <p>
            {t.legal.the_listings_of_doctors_hospitals_dialysis_c}
          </p>
          <p>
            {t.legal.inclusion_in_a_listing_is_not_a_recommendati}
          </p>
          <p>
            {t.legal.phone_numbers_addresses_and_chamber_hours_ch}
          </p>
        </div>
      </div>

      <div class="rounded-lg border border-(--color-line) bg-(--color-surface) p-6">
        <h2 class="text-display-4 text-(--color-ink)">
          {t.legal.want_your_details_removed_or_corrected}
        </h2>
        <p class="mt-2 text-(--color-ink-soft)">
          {t.legal.if_you_are_a_practitioner_or_institution_lis}
        </p>
        <a class="mt-4 inline-flex items-center gap-2 rounded-md bg-(--color-deep) px-5 py-2.5 text-sm font-semibold text-(--color-deep-ink) hover:brightness-110" href={slugSelector(`/contact`, lang)}>
          {t.legal.contact_us}
        </a>
      </div>

      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.no_fees_no_financial_intermediation}
        </h2>
        <div class="mt-3 space-y-3 text-(--color-ink-soft)">
          <p>
            {t.legal.everything_on_this_website_is_free_of_charge}
          </p>
          <p>
            {t.legal.bkpa_foundation_is_not_party_to_any_financia}
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.privacy_and_your_data}
        </h2>
        <div class="mt-3 space-y-3 text-(--color-ink-soft)">
          <p>
            {t.legal.this_website_has_no_accounts_and_no_forms_an}
          </p>
          <p>
            {t.legal.your_language_preference_and_any_rating_you_}
          </p>
          <p>
            {t.legal.two_third_party_services_are_used_each_with_}
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.copyright_and_use}
        </h2>
        <div class="mt-3 space-y-3 text-(--color-ink-soft)">
          <p>
            {t.legal.the_original_text_and_design_of_this_website}
          </p>
          <p>
            {t.legal.photographs_of_practitioners_remain_the_prop}
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.external_links}
        </h2>
        <p class="mt-3 text-(--color-ink-soft)">
          {t.legal.this_website_may_link_to_other_websites_we_h}
        </p>
      </div>

      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.corrections_and_complaints}
        </h2>
        <p class="mt-3 text-(--color-ink-soft)">
          {t.legal.our_information_is_gathered_with_care_but_er}
        </p>
      </div>

      <div>
        <h2 class="text-display-3 text-(--color-ink)">
          {t.legal.governing_law}
        </h2>
        <p class="mt-3 text-(--color-ink-soft)">
          {t.legal.this_website_and_its_use_are_governed_by_the}
        </p>
      </div>

    </div>
  </article>
</BaseLayout>
