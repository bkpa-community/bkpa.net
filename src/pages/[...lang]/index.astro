---
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import { getArticles, getGallery, getSiteHome } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import FindHelpWizard from "@/components/FindHelpWizard.astro";
import { CATEGORIES, EMERGENCY_CATEGORIES } from "@/lib/categories";

const home = (await getSiteHome(lang))!.data;

const articles = (await getArticles(lang)).filter((a) => !a.data.draft);
const countFor = (slug: string) => articles.filter((a) => a.id.startsWith(`${slug}/`)).length;
const photos = (await getGallery(lang)).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

---

<BaseLayout title="Home" description="Detect early, protect kidney health — BKPA Foundation, Bangladesh's first comprehensive Bengali-language kidney health resource.">
  <!-- ============ HERO ============ -->
  <section class="pt-16 pb-16 lg:pt-28 lg:pb-28">
    <div class="mx-auto grid max-w-6xl items-center gap-11 px-6 md:px-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-14">
      <div>
        <p class="text-eyebrow text-(--color-ink-soft)">
          <span class="i18n-bn bn">নন-প্রফিট চ্যারিটেবল অ্যাসোসিয়েশন · প্রতিষ্ঠা ২০১৫</span>
          <span class="i18n-en">Non-Profit Charitable Association · Est. 2015</span>
        </p>
        <h1 class="mt-3 text-display-1 leading-[1.08] font-semibold text-balance text-(--color-ink)">
          <span class="i18n-bn bn">বিকেপিএ ফাউন্ডেশন</span>
          <span class="i18n-en">BKPA Foundation</span>
        </h1>
        <p class="mt-4 max-w-xl text-[1.1rem] text-(--color-ink-soft)">
          <span class="i18n-bn bn-body">বাংলাদেশ কিডনি পেশেন্ট ফাউন্ডেশন(BKPA FOUNDATION) একটি স্বেচ্ছাসেবী সামাজিক সংগঠন যার লক্ষ্য কিডনি রোগ প্রতিরোধের জন্য সামাজিক সচেতনতা বৃদ্ধি, তথ্য আদান-প্রদান, এবং কিডনি রোগ সম্পর্কে মানুষকে সতর্ক করা।</span>
          <span class="i18n-en">BKPA (Bangladesh Kidney Patient) Foundation is a Non-profit Charitable Association, formed in April 2015 to build community engagement for the prevention of Kidney Disease through social awareness, sharing information, volunteerism and advocacy.</span>
        </p>
        <p class="mt-2.5 text-display-4 text-(--color-accent-2) italic">
          <span class="i18n-bn bn">"কিডনি সেবায় জ্ঞানের ব্যবধান কমিয়ে আনা"</span>
          <span class="i18n-en">"Bridging the knowledge gap to better kidney care."</span>
        </p>
        <div class="mt-7 flex">
          <a class="inline-flex items-center gap-2 rounded-md bg-(--color-deep) px-5.5 py-3 text-sm font-semibold text-(--color-deep-ink) hover:brightness-110" href={`${base}/emergency-contacts/nephrology-doctors`}>
            <span class="i18n-bn bn">জরুরি সহায়তা</span><span class="i18n-en">Emergency Help</span>
          </a>
        </div>
      </div>

      <div class="relative mx-auto hidden aspect-[1200/854] w-full max-w-md lg:block">
        <img
          class="h-full w-full object-contain"
          src={`${base}/images/hero-kidney-illustration.png`}
          alt="Line illustration of two kidneys"
          width="1200"
          height="854"
        />
      </div>
    </div>
  </section>

  <!-- ============ NOTICE BOARD ============ -->
  {home.notice.enable && (
    <div class="border-y border-(--color-line) bg-(--color-deep) text-(--color-deep-ink)">
      <div class="mx-auto max-w-6xl px-6 py-5 md:px-10">
        <p class="font-semibold">{home.notice.title}</p>
        <p class="mt-1.5 max-w-3xl whitespace-pre-line text-sm opacity-90">{home.notice.content}</p>
      </div>
    </div>
  )}

  <!-- ============ FIND HELP GENERATOR ============ -->
  <section class="bg-(--color-deep) py-14 md:py-20 text-(--color-deep-ink)" id="find-help">
    <div class="mx-auto max-w-4xl px-6 md:px-10">
      <div class="max-w-xl">
        <p class="text-eyebrow opacity-75"><span class="i18n-bn bn">সহায়তা খুঁজুন</span><span class="i18n-en">Find Help</span></p>
        <h2 class="mt-1.5 text-display-3"><span class="i18n-bn bn">আমরা কীভাবে সাহায্য করতে পারি?</span><span class="i18n-en">How can we help?</span></h2>
        <p class="mt-2 opacity-90"><span class="i18n-bn bn-body">কয়েকটি প্রশ্নের উত্তর দিন — আমরা আপনাকে সঠিক তথ্যের দিকে পথ দেখাবো।</span><span class="i18n-en">Answer a few quick questions and we'll point you to the right resources for you.</span></p>
      </div>

      <div class="mt-8 rounded-xl border border-(--color-line) bg-(--color-paper) p-6 text-(--color-ink) md:p-8">
        <FindHelpWizard />
      </div>
    </div>
  </section>

  <!-- ============ KNOW YOUR KIDNEY ============ -->
  <section class="py-14 md:py-20" id="topics">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="mb-8 max-w-xl">
        <p class="text-eyebrow text-(--color-ink-soft)"><span class="i18n-bn bn">শিক্ষামূলক রিসোর্স</span><span class="i18n-en">Educational Resource</span></p>
        <h2 class="mt-1.5 text-display-3 text-(--color-ink)"><span class="i18n-bn bn">আপনার কিডনি সম্পর্কে জানুন</span><span class="i18n-en">Know Your Kidney</span></h2>
        <p class="mt-2 text-(--color-ink-soft)"><span class="i18n-bn bn-body">কিডনির গঠন থেকে ডায়ালাইসিস ও প্রতিস্থাপন পর্যন্ত — প্রতিটি বিষয় সহজ বাংলায় ব্যাখ্যা করা।</span><span class="i18n-en">From kidney basics to dialysis and transplantation — every topic explained in plain Bengali and English.</span></p>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {CATEGORIES.map((c) => (
          <a class="flex min-h-[9.5rem] flex-col justify-between gap-3 rounded-lg border border-(--color-line) bg-(--color-surface) p-5 hover:border-(--color-deep)" href={`${base}/know-your-kidney/${c.slug}`}>
            <div>
              <CategoryIcon slug={c.slug} class="h-6 w-6 text-(--color-deep)" />
              <p class="mt-2.5 text-display-4">
                <span class="i18n-en">{c.labelEn}</span>
                <span class="i18n-bn bn block">{c.labelBn}</span>
              </p>
            </div>
            <span class="font-mono text-xs text-(--color-ink-soft) tabular-nums">{countFor(c.slug)} <span class="i18n-bn bn">টি আর্টিকেল</span><span class="i18n-en">articles</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EMERGENCY ============ -->
  <section class="bg-(--color-deep) py-14 md:py-20 text-(--color-deep-ink)" id="emergency">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="mb-8 max-w-xl">
        <p class="text-eyebrow opacity-75"><span class="i18n-bn bn">তাৎক্ষণিক প্রয়োজনে</span><span class="i18n-en">When you need it now</span></p>
        <h2 class="mt-1.5 text-display-3"><span class="i18n-bn bn">জরুরি যোগাযোগ</span><span class="i18n-en">Emergency Contacts</span></h2>
        <p class="mt-2 opacity-90"><span class="i18n-bn bn-body">নেফ্রোলজিস্ট থেকে ব্লাড ব্যাংক পর্যন্ত — ক্যাটাগরি অনুযায়ী দ্রুত খুঁজে নিন।</span><span class="i18n-en">From nephrologists to blood banks — find the right contact by category, fast.</span></p>
      </div>
      <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3">
        {EMERGENCY_CATEGORIES.map((c) => (
          <a class="rounded-lg border border-[color-mix(in_srgb,var(--color-deep-ink)_30%,transparent)] bg-[color-mix(in_srgb,var(--color-deep-ink)_12%,transparent)] p-4.5 hover:bg-[color-mix(in_srgb,var(--color-deep-ink)_20%,transparent)]" href={`${base}/emergency-contacts/${c.slug}`}>
            <span class="block text-sm font-semibold"><span class="i18n-bn bn">{c.labelBn}</span><span class="i18n-en">{c.labelEn}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GALLERY ============ -->
  {photos.length > 0 && (
    <section class="py-14 md:py-20">
      <div class="mx-auto max-w-6xl px-6 md:px-10">
        <div class="mb-8 max-w-xl">
          <p class="text-eyebrow text-(--color-ink-soft)"><span class="i18n-bn bn">ছবিঘর</span><span class="i18n-en">Gallery</span></p>
          <h2 class="mt-1.5 text-display-3 text-(--color-ink)"><span class="i18n-bn bn">আমাদের কার্যক্রম</span><span class="i18n-en">Our Activities</span></h2>
        </div>
        <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-4">
          {photos.map((p) => (
            <figure class="group overflow-hidden rounded-lg border border-(--color-line) bg-(--color-surface)">
              <div class="aspect-square overflow-hidden">
                <img
                  class="h-full w-full object-cover transition group-hover:scale-105"
                  src={encodeURI(`${base}${p.data.image}`)}
                  alt={p.data.caption}
                  loading="lazy"
                  width="400"
                  height="400"
                />
              </div>
              {p.data.caption && <figcaption class="p-2.5 text-xs text-(--color-ink-soft)">{p.data.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
