---
import { slugSelector } from "@/lib/languageParser";
import { getTranslations } from "@/lib/translations";
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import { getArticles, getGallery, getSiteHome } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import FindHelpWizard from "@/components/FindHelpWizard.astro";
import { CATEGORIES, EMERGENCY_CATEGORIES } from "@/lib/categories";

const t = getTranslations(lang);

const home = (await getSiteHome(lang))!.data;

const articles = (await getArticles(lang)).filter((a) => !a.data.draft);
const countFor = (slug: string) => articles.filter((a) => a.id.startsWith(`${slug}/`)).length;
const photos = (await getGallery(lang)).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

---

<BaseLayout lang={lang} title={t.nav.home} description="Detect early, protect kidney health — BKPA Foundation, Bangladesh's first comprehensive Bengali-language kidney health resource.">
  <!-- ============ HERO ============ -->
  <section class="pt-16 pb-16 lg:pt-28 lg:pb-28">
    <div class="mx-auto grid max-w-6xl items-center gap-11 px-6 md:px-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-14">
      <div>
        <p class="text-eyebrow text-(--color-ink-soft)">
          {t.home.non_profit_charitable_association_est_2015}
        </p>
        <h1 class="mt-3 text-display-1 leading-[1.08] font-semibold text-balance text-(--color-ink)">
          {t.home.bkpa_foundation}
        </h1>
        <p class="mt-4 max-w-xl text-[1.1rem] text-(--color-ink-soft)">
          {t.home.bkpa_bangladesh_kidney_patient_foundation_is}
        </p>
        <p class="mt-2.5 text-display-4 text-(--color-accent-2) italic">
          {t.home.bridging_the_knowledge_gap_to_better_kidney_}
        </p>
        <div class="mt-7 flex">
          <a class="inline-flex items-center gap-2 rounded-md bg-(--color-deep) px-5.5 py-3 text-sm font-semibold text-(--color-deep-ink) hover:brightness-110" href={slugSelector(`/emergency-contacts/nephrology-doctors`, lang)}>
            {t.home.emergency_help}
          </a>
        </div>
      </div>

      <div class="relative mx-auto hidden aspect-[1200/854] w-full max-w-md lg:block">
        <img
          class="h-full w-full object-contain"
          src={`${base}/images/hero-kidney-illustration.png`}
          alt="Line illustration of two kidneys"
          width="1200"
          height="854"
        />
      </div>
    </div>
  </section>

  <!-- ============ NOTICE BOARD ============ -->
  {home.notice.enable && (
    <div class="border-y border-(--color-line) bg-(--color-deep) text-(--color-deep-ink)">
      <div class="mx-auto max-w-6xl px-6 py-5 md:px-10">
        <p class="font-semibold">{home.notice.title}</p>
        <p class="mt-1.5 max-w-3xl whitespace-pre-line text-sm opacity-90">{home.notice.content}</p>
      </div>
    </div>
  )}

  <!-- ============ FIND HELP GENERATOR ============ -->
  <section class="bg-(--color-deep) py-14 md:py-20 text-(--color-deep-ink)" id="find-help">
    <div class="mx-auto max-w-4xl px-6 md:px-10">
      <div class="max-w-xl">
        <p class="text-eyebrow opacity-75">{t.home.find_help}</p>
        <h2 class="mt-1.5 text-display-3">{t.home.how_can_we_help}</h2>
        <p class="mt-2 opacity-90">{t.home.answer_a_few_quick_questions_and_we_ll_point}</p>
      </div>

      <div class="mt-8 rounded-xl border border-(--color-line) bg-(--color-paper) p-6 text-(--color-ink) md:p-8">
        <FindHelpWizard lang={lang} />
      </div>
    </div>
  </section>

  <!-- ============ KNOW YOUR KIDNEY ============ -->
  <section class="py-14 md:py-20" id="topics">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="mb-8 max-w-xl">
        <p class="text-eyebrow text-(--color-ink-soft)">{t.home.educational_resource}</p>
        <h2 class="mt-1.5 text-display-3 text-(--color-ink)">{t.home.know_your_kidney}</h2>
        <p class="mt-2 text-(--color-ink-soft)">{t.home.from_kidney_basics_to_dialysis_and_transplan}</p>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {CATEGORIES.map((c) => (
          <a class="flex min-h-[9.5rem] flex-col justify-between gap-3 rounded-lg border border-(--color-line) bg-(--color-surface) p-5 hover:border-(--color-deep)" href={slugSelector(`/know-your-kidney/${c.slug}`, lang)}>
            <div>
              <CategoryIcon slug={c.slug} class="h-6 w-6 text-(--color-deep)" />
              <p class="mt-2.5 text-display-4">
                {t.home.c_labelen}
              </p>
            </div>
            <span class="font-mono text-xs text-(--color-ink-soft) tabular-nums">{countFor(c.slug)} {t.home.articles}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EMERGENCY ============ -->
  <section class="bg-(--color-deep) py-14 md:py-20 text-(--color-deep-ink)" id="emergency">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="mb-8 max-w-xl">
        <p class="text-eyebrow opacity-75">{t.home.when_you_need_it_now}</p>
        <h2 class="mt-1.5 text-display-3">{t.home.emergency_contacts}</h2>
        <p class="mt-2 opacity-90">{t.home.from_nephrologists_to_blood_banks_find_the_r}</p>
      </div>
      <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3">
        {EMERGENCY_CATEGORIES.map((c) => (
          <a class="rounded-lg border border-[color-mix(in_srgb,var(--color-deep-ink)_30%,transparent)] bg-[color-mix(in_srgb,var(--color-deep-ink)_12%,transparent)] p-4.5 hover:bg-[color-mix(in_srgb,var(--color-deep-ink)_20%,transparent)]" href={slugSelector(`/emergency-contacts/${c.slug}`, lang)}>
            <span class="block text-sm font-semibold">{t.home.c_labelen}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GALLERY ============ -->
  {photos.length > 0 && (
    <section class="py-14 md:py-20">
      <div class="mx-auto max-w-6xl px-6 md:px-10">
        <div class="mb-8 max-w-xl">
          <p class="text-eyebrow text-(--color-ink-soft)">{t.home.gallery}</p>
          <h2 class="mt-1.5 text-display-3 text-(--color-ink)">{t.home.our_activities}</h2>
        </div>
        <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-4">
          {photos.map((p) => (
            <figure class="group overflow-hidden rounded-lg border border-(--color-line) bg-(--color-surface)">
              <div class="aspect-square overflow-hidden">
                <img
                  class="h-full w-full object-cover transition group-hover:scale-105"
                  src={encodeURI(`${base}${p.data.image}`)}
                  alt={p.data.caption}
                  loading="lazy"
                  width="400"
                  height="400"
                />
              </div>
              {p.data.caption && <figcaption class="p-2.5 text-xs text-(--color-ink-soft)">{p.data.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
