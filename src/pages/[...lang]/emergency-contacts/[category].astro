---
import { getEmergencyContacts } from "@/lib/content";
import { langParam, supportedLanguages } from "@/lib/languageParser";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { render } from "astro:content";
import { EMERGENCY_CATEGORIES } from "@/lib/categories";
import { breadcrumbSchema } from "@/lib/schema";


export async function getStaticPaths() {
  // One route per language per category. The content itself falls back to
  // Bengali inside getEmergencyContacts, so an English route exists even
  // before an English file does.
  const paths = [];
  for (const language of supportedLanguages) {
    const all = await getEmergencyContacts(language.languageCode);
    for (const entry of all) {
      paths.push({
        params: { lang: langParam(language.languageCode), category: entry.id },
        props: { entry, lang: language.languageCode },
      });
    }
  }
  return paths;
}

const { entry, lang } = Astro.props;
const meta = EMERGENCY_CATEGORIES.find((c) => c.slug === entry.id);
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = entry.data.items ?? [];

// Group by city, then order within each group by `rank` (lower first).
// Entries without a rank keep their original file order and follow the ranked
// ones. Grouping here rather than relying on a heading-on-change means the
// markdown no longer has to be pre-sorted — an entry added anywhere in the
// file still lands under the right heading.
const groups = items.reduce<{ name: string | undefined; items: typeof items }[]>((acc, item, index) => {
  const bucket = acc.find((g) => g.name === item.group);
  const withIndex = Object.assign({}, item, { __index: index });
  if (bucket) bucket.items.push(withIndex);
  else acc.push({ name: item.group, items: [withIndex] });
  return acc;
}, []);

const RANK_LAST = Number.MAX_SAFE_INTEGER;
for (const group of groups) {
  group.items.sort((a, b) => {
    const byRank = (a.rank ?? RANK_LAST) - (b.rank ?? RANK_LAST);
    return byRank !== 0 ? byRank : (a as never as { __index: number }).__index - (b as never as { __index: number }).__index;
  });
}

const pageSchema = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Emergency Contacts", path: "/emergency-contacts" },
  { name: meta?.labelEn ?? entry.data.title, path: `/emergency-contacts/${entry.id}` },
]);
---

<BaseLayout title={entry.data.title} description={`Emergency contact list — ${entry.data.title}, BKPA Foundation`} schema={pageSchema}>
  <section class="bg-(--color-deep) py-10 text-(--color-deep-ink)">
    <div class="mx-auto max-w-5xl px-6 md:px-10">
      <p class="text-eyebrow opacity-75"><span class="i18n-bn bn">জরুরি যোগাযোগ</span><span class="i18n-en">Emergency Contacts</span></p>
      <h1 class="mt-1.5 text-display-2">
        <span class="i18n-en">{meta?.labelEn ?? entry.data.title}</span>
        <span class="i18n-bn bn block">{meta?.labelBn}</span>
      </h1>
    </div>
  </section>
  <nav class="border-b border-(--color-line) bg-(--color-surface)">
    <div class="mx-auto flex max-w-5xl flex-wrap gap-2 px-6 py-3 md:px-10">
      {EMERGENCY_CATEGORIES.map((c) => (
        <a
          class:list={[
            "rounded-full border px-3.5 py-1.5 text-xs font-semibold",
            c.slug === entry.id ? "border-(--color-deep) bg-(--color-deep) text-(--color-deep-ink)" : "border-(--color-line) text-(--color-ink-soft) hover:text-(--color-ink)",
          ]}
          href={`${base}/emergency-contacts/${c.slug}`}
        >
          <span class="i18n-bn bn">{c.labelBn}</span><span class="i18n-en">{c.labelEn}</span>
        </a>
      ))}
    </div>
  </nav>

  {items.length > 0 ? (
    <article class="py-12">
      <div class="mx-auto max-w-5xl px-6 md:px-10">
        {entry.data.intro && <p class="mb-8 max-w-3xl text-(--color-ink-soft)">{entry.data.intro}</p>}
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {groups.map((group) => (
            <>
              {group.name && (
                <h2 class="col-span-full mt-2 font-mono text-xs font-semibold tracking-wider text-(--color-ink-soft) uppercase first:mt-0">{group.name}</h2>
              )}
              {group.items.map((item) => (
                <div class="flex flex-col overflow-hidden rounded-lg border border-(--color-line)">
                  <div class="aspect-square overflow-hidden bg-(--color-surface-2)">
                    {item.image ? (
                      <img
                        class="h-full w-full object-cover"
                        src={encodeURI(`${base}${item.image}`)}
                        alt={item.name}
                        loading="lazy"
                        width="480"
                        height="480"
                      />
                    ) : (
                      // No photo: a plain brand-colour block. The name is
                      // already in the heading below, so this carries no
                      // information and needs no text.
                      <div class="h-full w-full bg-(--color-deep)"></div>
                    )}
                  </div>
                  <div class="min-w-0 p-5">
                    <h3 class="text-display-4">{item.name}</h3>
                    {item.role && <p class="mt-0.5 text-body-sm text-(--color-ink-soft)">{item.role}</p>}
                    {item.address && <p class="mt-1.5 text-body-sm text-(--color-ink-soft)">{item.address}</p>}
                    <div class="mt-2 flex flex-col gap-0.5 font-mono text-[0.8125rem] text-(--color-ink-soft) sm:text-xs">
                      {item.phone && <span>{item.phone}</span>}
                      {item.email && (
                        <a class="hover:text-(--color-deep)" href={`mailto:${item.email}`}>{item.email}</a>
                      )}
                      {item.website && (
                        <a class="hover:text-(--color-deep)" href={item.website.startsWith("http") ? item.website : `https://${item.website}`} target="_blank" rel="noopener">
                          {item.website}
                        </a>
                      )}
                    </div>
                    {item.notes && <p class="mt-2 text-[0.8125rem] text-(--color-ink-soft) italic sm:text-xs">{item.notes}</p>}
                  </div>
                </div>
              ))}
            </>
          ))}
        </div>
      </div>
    </article>
  ) : (
    <article class="py-12">
      <div class="mx-auto max-w-3xl px-6 md:px-10">
        <div class="prose-bkpa">
          <Content />
        </div>
      </div>
    </article>
  )}
</BaseLayout>
