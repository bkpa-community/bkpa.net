---
import { slugSelector } from "@/lib/languageParser";
import { getTranslations } from "@/lib/translations";
import { languagePaths } from "@/lib/languageParser";

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
import { getEmergencyContacts } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { EMERGENCY_CATEGORIES } from "@/lib/categories";
import { breadcrumbSchema } from "@/lib/schema";

const t = getTranslations(lang);

const all = await getEmergencyContacts(lang);
const countFor = (slug: string) => all.find((e) => e.id === slug)?.data.items?.length ?? 0;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageSchema = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Emergency Contacts", path: "/emergency-contacts" },
]);
---

<BaseLayout lang={lang} title={t.nav.emergency_contacts} description="Emergency contact directory — nephrology doctors, vascular surgeons, dialysis centers, and blood banks, BKPA Foundation" schema={pageSchema}>
  <section class="bg-(--color-deep) py-10 text-(--color-deep-ink)">
    <div class="mx-auto max-w-5xl px-6 md:px-10">
      <p class="text-eyebrow opacity-75">{t.emergency.when_you_need_it_now}</p>
      <h1 class="mt-1.5 text-display-2">
        {t.emergency.emergency_contacts}
      </h1>
      <p class="mt-2 max-w-xl opacity-90">{t.emergency.from_nephrologists_to_blood_banks_find_the_r}</p>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid gap-4 sm:grid-cols-2">
        {EMERGENCY_CATEGORIES.map((c) => (
          <a class="flex flex-col justify-between gap-4 rounded-lg border border-(--color-line) bg-(--color-surface) p-6 hover:border-(--color-deep)" href={slugSelector(`/emergency-contacts/${c.slug}`, lang)}>
            <div>
              <h2 class="text-display-4">
                {lang === "en" ? c.labelEn : c.labelBn}
              </h2>
            </div>
            <span class="font-mono text-xs text-(--color-ink-soft) tabular-nums">
              {countFor(c.slug)} {t.emergency.entries}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
