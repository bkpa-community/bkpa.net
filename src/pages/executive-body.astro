---
import { getSiteAbout, getTeam } from "@/lib/content";
import { defaultLanguage } from "@/lib/languageParser";
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema } from "../lib/schema";

const lang = defaultLanguage.languageCode;

const about = (await getSiteAbout(lang))!.data;
const members = (await getTeam(lang)).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageSchema = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Executive Body", path: "/executive-body" },
]);
---

<BaseLayout title="Executive Body" description={about.description} schema={pageSchema}>
  <section class="py-12">
    <div class="mx-auto max-w-5xl px-6 md:px-10">
      <p class="text-eyebrow text-(--color-ink-soft)"><span class="i18n-bn bn">সংগঠন</span><span class="i18n-en">Organization</span></p>
      <h1 class="mt-1.5 text-display-2 text-(--color-ink)">
        <span class="i18n-bn bn">কার্যনির্বাহী পরিষদ</span><span class="i18n-en">Executive Body</span>
      </h1>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((m) => (
          <div class="rounded-lg border border-(--color-line) bg-(--color-surface) p-5">
            {m.data.image && (
              <img class="mb-4 h-24 w-24 rounded-full border border-(--color-line) object-cover" src={encodeURI(`${base}${m.data.image}`)} alt={m.data.name} loading="lazy" width="96" height="96" />
            )}
            <h2 class="text-display-4">{m.data.name}</h2>
            {m.data.role && <p class="mt-1 text-sm text-(--color-ink-soft)">{m.data.role}</p>}
            <div class="mt-3 flex flex-col gap-1 font-mono text-xs text-(--color-ink-soft) tabular-nums">
              {m.data.phone && <a class="hover:text-(--color-deep)" href={`tel:${m.data.phone}`}>{m.data.phone}</a>}
              {m.data.email && <a class="hover:text-(--color-deep)" href={`mailto:${m.data.email}`}>{m.data.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
