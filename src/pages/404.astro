---
/**
 * Not-found page.
 *
 * Deliberately NOT under [...lang]: a static host serves one file for every
 * unmatched path, and it must build to dist/404.html for GitHub Pages to
 * find it. So this page is always in the default language — it cannot know
 * which language the missing URL was meant to be.
 *
 * A dead link on a kidney-health site is often someone following an old
 * Facebook post while worried about a diagnosis, so this offers the three
 * ways back in — search, the topic list, the homepage — rather than an
 * apology.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import { getTranslations } from "@/lib/translations";
import { defaultLanguage, slugSelector } from "@/lib/languageParser";
import { CATEGORIES } from "@/lib/categories";

const lang = defaultLanguage.languageCode;
const t = getTranslations(lang);
const isBn = lang === "bn";
const categories = [...CATEGORIES].sort((a, b) => a.weight - b.weight);
---

<BaseLayout lang={lang} title={t.not_found.title} description={t.not_found.lead}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-6 text-center md:px-10">
      <p class="font-mono text-display-2 leading-none text-(--color-line)">404</p>
      <h1 class:list={["mt-5 text-display-2 text-balance text-(--color-ink)", isBn && "bn"]}>
        {t.not_found.title}
      </h1>
      <p class:list={["mx-auto mt-4 max-w-xl text-(--color-ink-soft)", isBn && "bn-body"]}>
        {t.not_found.lead}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          data-search-open
          class="rounded-md bg-(--color-deep) px-5 py-3 font-semibold text-(--color-deep-ink) hover:opacity-90"
        >
          {t.not_found.search_cta}
        </button>
        <a
          class="rounded-md border border-(--color-line) px-5 py-3 font-semibold text-(--color-ink) no-underline hover:bg-(--color-surface-2)"
          href={slugSelector("/", lang)}
        >
          {t.not_found.home_cta}
        </a>
      </div>
    </div>

    <div class="mx-auto mt-14 max-w-5xl px-6 md:px-10">
      <h2 class:list={["text-eyebrow text-center text-(--color-ink-soft)", isBn && "bn"]}>
        {t.not_found.browse}
      </h2>
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {categories.map((c) => (
          <li>
            <a
              class="flex h-full items-center gap-2.5 rounded-lg border border-(--color-line) bg-(--color-surface) px-3.5 py-3 text-(--color-ink) no-underline hover:border-(--color-deep) hover:bg-(--color-surface-2)"
              href={slugSelector(`/${c.slug}`, lang)}
            >
              <CategoryIcon slug={c.slug} class="h-5 w-5 flex-none text-(--color-deep)" />
              <span class:list={["text-body-sm font-semibold", isBn && "bn"]}>
                {isBn ? c.labelBn : c.labelEn}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class:list={["mx-auto mt-10 max-w-xl text-center text-meta text-(--color-ink-soft)", isBn && "bn-body"]}>
        {t.not_found.emergency}
      </p>
    </div>
  </section>
</BaseLayout>
